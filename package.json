  "repository": "github:SimpleMatt7/Gambetto",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.ts",
    "server": "node --disable-warning=ExperimentalWarning server/index.ts",
    "start": "npm run build && npm run server",
    "test:server": "node --disable-warning=ExperimentalWarning scripts/e2e.ts",
    "test:sicurezza": "node --disable-warning=ExperimentalWarning scripts/sicurezza.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "^19.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
