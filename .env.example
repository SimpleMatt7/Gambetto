# Impostazioni per la VPS: copia questo file in ".env" nella stessa cartella di docker-compose.yml.

# Immagine pubblicata dalla pipeline di GitHub (il nome utente va scritto in minuscolo).
GAMBETTO_IMAGE=ghcr.io/simplematt7/gambetto:latest

# Il sito pubblico è in HTTPS: il cookie di sessione deve viaggiare solo su connessioni cifrate.
COOKIE_SECURE=1

# Porta locale su cui risponde il contenitore (quella a cui punta il reverse proxy di aaPanel).
GAMBETTO_PORT=8787
